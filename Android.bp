// Soong namespace for the meizu_m6 device tree.
//
// Without a soong_namespace every module here would land in the root
// namespace and get install rules in every product of the workspace (Soong
// has no TARGET_DEVICE guard). A namespace is only exported to Make for
// products that list it in PRODUCT_SOONG_NAMESPACES (see device.mk); modules
// inside it can still depend on root-namespace modules.
soong_namespace {
}

// Vendor-side stand-ins for libraries the Nougat blobs need but a vendor
// process cannot reach in /system. Installed by device.mk.

cc_defaults {
    name: "meizu_m6_shim_defaults",
    vendor: true,
    cflags: ["-Wno-unused-parameter"],
}

// /vendor/lib{,64}/libgui.so: an empty library whose only content is
// DT_NEEDED on libgui_vendor. libgui is VNDK-private, so the vendor namespace
// has no link to it, yet many blobs (hwcomposer.mt6755, libgui_ext, libaal,
// ged_srv, camera) NEED the plain name libgui.so.
cc_library_shared {
    name: "libgui_fwd_meizu_m6",
    defaults: ["meizu_m6_shim_defaults"],
    stem: "libgui",
    srcs: ["shims/stub.c"],
    shared_libs: ["libgui_vendor"],
}

// /vendor/lib{,64}/libfs_mgr.so: Nougat-ABI fstab reader. libnvram.so imports
// fs_mgr_read_fstab, fs_mgr_get_entry_for_mount_point and fs_mgr_free_fstab,
// while libfs_mgr is only built as a static library; without this shim
// libnvram, and with it every NVRAM consumer, cannot load.
cc_library_shared {
    name: "libfs_mgr_shim_meizu_m6",
    defaults: ["meizu_m6_shim_defaults"],
    stem: "libfs_mgr",
    srcs: ["shims/fs_mgr.c"],
}

// Nougat-ABI shims shared with device/meizu/m95: the blob set is the same
// MediaTek Nougat generation. The blobs are patched to NEED the shims at
// import time (see shims/wiring.txt).

cc_library_shared {
    name: "libmeizu_m6shim_gui",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/gui.cpp"],
    shared_libs: ["liblog"],
    allow_undefined_symbols: true,
}

// graphicbuffer.cpp provides the Nougat GraphicBuffer(w, h, format, usage)
// constructor that libui_ext (hwcomposer) calls and the platform libui lacks.
// Its callers are byte-patched to allocate the current object size
// (shims/bytepatch.txt).
cc_library_shared {
    name: "libmeizu_m6shim_ui",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: [
        "shims/ui.cpp",
        "shims/graphicbuffer.cpp",
    ],
    shared_libs: ["liblog", "libui"],
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libmeizu_m6shim_sf",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/sf.cpp"],
}

cc_library_shared {
    name: "libmeizu_m6shim_utils",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: [
        "shims/utils.cpp",
        "shims/propertymap.cpp",
    ],
    shared_libs: ["libutils"],
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libmeizu_m6shim_audioutils",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/audioutils.cpp"],
    allow_undefined_symbols: true,
}

// android::Region with the Nougat object layout for the Mali EGL driver, which
// owns 32-byte Region objects and reads the fields itself. Its libui.so
// NEEDED entry is replaced by this library (wiring.txt).
cc_library_shared {
    name: "libmeizu_m6shim_region",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/region.cpp"],
    header_libs: ["libutils_headers", "liblog_headers"],
    shared_libs: ["liblog"],
    cflags: ["-fvisibility=hidden"],
}

cc_library_shared {
    name: "libmeizu_m6shim_net",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/net.c"],
}

cc_library_shared {
    name: "libmeizu_m6shim_power",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/power.cpp"],
}

// /vendor/lib{,64}/libnetd_client.so: mtk-ril and mtk-rilmd2 NEED it by name
// and import protectFromVpn. The library is system-only on this platform, so
// rild could not dlopen mtk-ril.so without it. setNetworkForSocket forwards
// to the LLNDK android_setsocknetwork.
cc_library_shared {
    name: "libmeizu_m6shim_netd_client",
    defaults: ["meizu_m6_shim_defaults"],
    stem: "libnetd_client",
    srcs: ["shims/netd_client.c"],
    shared_libs: ["libandroid_net"],
}

// SSLv3_{client,server}_method for mtk_agpsd (SUPL/AGPS) and libcurl-ss:
// BoringSSL dropped SSLv3, so these map to TLS_*_method.
cc_library_shared {
    name: "libmeizu_m6shim_ssl",
    defaults: ["meizu_m6_shim_defaults"],
    srcs: ["shims/ssl.c"],
    shared_libs: ["libssl"],
}
