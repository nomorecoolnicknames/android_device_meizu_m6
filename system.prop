# system.prop - Meizu M6 (meizu_m6 / M711), MT6750
#
# Vendor-side properties (density, RIL, hw module suffixes, rotation, AEE)
# are in vendor.prop.

ro.forge.meizu.expect_codename=meizu_m6

# Keep HWC enabled: GPU-only composition causes system-wide UI lag.
# Fallback if the panel glitches: debug.sf.disable_hwc=1 with
# debug.composition.type=gpu.
debug.sf.disable_hwc=0

# The mBack key layout comes from the fingerprint stack, which is not shipped
# yet, so keep the on-screen navigation bar.
qemu.hw.mainkeys=0
