# MediaTek NVRAM (IMEI, RF calibration, Wi-Fi/BT MAC, audio parameters) for
# the Meizu M6. Imported by init.mt6755.rc before init.meizu_m6.modem.rc.
#
# The modem depends on it: ccci_mdinit waits for service.nvram_init, which
# nvram_daemon sets, and ccci_fsd serves the modem file system out of
# /data/nvram/md{,3}. The calibrated records live on the nvdata partition,
# which is bind-mounted over /data/nvram (a symlink cannot replace an
# existing directory).

on post-fs-data
    chown root system /nvdata
    chmod 0771 /nvdata
    restorecon_recursive /nvdata

    mkdir /data/nvram 0771 root system
    mount none /nvdata /data/nvram bind
    chown root system /data/nvram
    chmod 0771 /data/nvram

    # libnvram parses /data/nvram/fstab.${ro.hardware} to find the raw /nvram
    # partition. The ramdisk copy is gone after switch_root, so it is copied
    # from /vendor/etc.
    copy /vendor/etc/fstab.mt6755 /data/nvram/fstab.mt6755
    chown root root /data/nvram/fstab.mt6755
    chmod 0644 /data/nvram/fstab.mt6755

    # Audio calibration records are read by audioserver (group media).
    mkdir /data/nvram/media 0770 root media
    mkdir /data/nvram/APCFG 0771 root system
    mkdir /data/nvram/APCFG/APRDCL 0771 root system
    mkdir /data/nvram/APCFG/APRDEB 0771 root system
    restorecon_recursive /data/nvram

# 32-bit blob; sets service.nvram_init=Ready.
service nvram_daemon /vendor/bin/nvram_daemon
    class main
    user root
    group system
    oneshot

# Registers the "NvRAMAgent" binder service used by MediaTek apps and some
# HALs.
service NvRAMAgent /vendor/bin/nvram_agent_binder
    class main
    user system
    group system
