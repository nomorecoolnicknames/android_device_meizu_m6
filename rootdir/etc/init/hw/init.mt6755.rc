# Vendor init for the Meizu M6 (meizu_m6 / M711): MT6750 silicon with
# ro.hardware=mt6755. Installed as /vendor/etc/init/hw/init.mt6755.rc.
#
# init imports only /vendor/etc/init/hw/init.${ro.hardware}.rc and does not
# parse the hw/ subdirectory itself, so every file below is imported by its
# installed path. There are no seclabel lines yet: the vendor sepolicy is a
# placeholder and the build is permissive.

import /vendor/etc/init/hw/init.mt6755.usb.rc
# nvram before modem: the /nvdata bind mount must happen before
# init.meizu_m6.modem.rc creates /data/nvram/md*. Actions of the same trigger
# run in import order.
import /vendor/etc/init/hw/init.meizu_m6.nvram.rc
import /vendor/etc/init/hw/init.meizu_m6.modem.rc
import /vendor/etc/init/hw/init.meizu_m6.tee.rc
import /vendor/etc/init/hw/init.meizu_m6.connectivity.rc
import /vendor/etc/init/hw/init.meizu_m6.thermal.rc
# init.meizu_m6.sensors.rc lives in /vendor/etc/init and is parsed
# automatically, after the AOSP sensors rc.

on early-init
    # Boot-time CPU floor (cluster 1 at 1.508 GHz, one core held), released
    # at sys.boot_completed. /proc/ppm is the MT6755 PPM driver.
    write /proc/ppm/policy/userlimit_min_cpu_freq "1 1508000"
    write /proc/ppm/policy/userlimit_min_cpu_core "1 1"

    # debugfs is not mounted by the platform, but the vendor HALs read it
    # (memtrack.mt6750 walks ion/clients and mali0/gpu_memory).
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    # atrace.rc's chmod fires too late; the node exists right after the
    # mount above.
    chmod 0222 /sys/kernel/debug/tracing/trace_marker

    # The 3.18 kernel dumps registers for every unknown syscall (statx etc.);
    # keep ENOSYS, drop the dumps.
    write /proc/sys/debug/exception-trace 0

on init
    # The Mali midgard r12 driver with the Nougat userspace shows GPU page
    # faults and black frames with the Skia-GL RenderEngine; use GLES.
    setprop debug.renderengine.backend gles

    # cameraserver and the camera provider join the camera-daemon cpuset,
    # which the platform init.rc does not create under cpuset.
    mkdir /dev/cpuset/camera-daemon 0755 system system
    copy /dev/cpuset/cpus /dev/cpuset/camera-daemon/cpus
    copy /dev/cpuset/mems /dev/cpuset/camera-daemon/mems
    chown system system /dev/cpuset/camera-daemon/tasks
    chmod 0664 /dev/cpuset/camera-daemon/tasks

    chown root system /proc/lk_env
    chmod 0660 /proc/lk_env

on fs
    # Use the installed fstab: the ramdisk copy is gone after switch_root.
    # /system and /vendor are already mounted by first stage; the mount points
    # of /protect_f, /protect_s and /nvdata come from BOARD_ROOT_EXTRA_FOLDERS.
    mount_all /vendor/etc/fstab.mt6755

on post-fs
    chown system system /proc/bootprof
    chmod 0664 /proc/bootprof
    chown system system /protect_f
    chmod 0770 /protect_f
    chown system system /protect_s
    chmod 0770 /protect_s
    # Relabel the NV mounts; freshly formatted ext4 comes up unlabeled.
    restorecon_recursive /protect_f
    restorecon_recursive /protect_s

on post-fs-data
    # zram (see fstab.mt6755); the platform init.rc has no swapon_all.
    swapon_all /vendor/etc/fstab.mt6755

    # Thermal policy store, used by libmtcloader.
    mkdir /data/.tp 0775 system system

on boot
    # fb blank control for the legacy fb path.
    chown system graphics /sys/class/graphics/fb0/blank
    chmod 0660 /sys/class/graphics/fb0/blank

    # LEDs. lcd-backlight/brightness is chowned by the platform init.rc.
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/trigger
    chown system system /sys/class/leds/red/trigger
    chown system system /sys/class/leds/green/trigger
    chown system system /sys/class/leds/blue/trigger
    chown system system /sys/class/leds/mx-led/brightness
    chown system system /sys/class/leds/mx-led/blink
    chmod 0664 /sys/class/leds/mx-led/brightness
    chmod 0664 /sys/class/leds/mx-led/blink

    # GED HAL knobs for ged_srv.
    chown system system /sys/kernel/debug/ged/hal/total_gpu_freq_level_count
    chmod 0660 /sys/kernel/debug/ged/hal/total_gpu_freq_level_count
    chown system system /sys/kernel/debug/ged/hal/custom_boost_gpu_freq
    chmod 0660 /sys/kernel/debug/ged/hal/custom_boost_gpu_freq
    chown system system /sys/kernel/debug/ged/hal/custom_upbound_gpu_freq
    chmod 0660 /sys/kernel/debug/ged/hal/custom_upbound_gpu_freq
    chown system system /sys/kernel/debug/ged/hal/event_notify
    chmod 0660 /sys/kernel/debug/ged/hal/event_notify
    chown system system /sys/kernel/debug/ged/hal/fps_upper_bound
    chmod 0660 /sys/kernel/debug/ged/hal/fps_upper_bound

on property:sys.boot_completed=1
    # Release the early-init CPU floor.
    write /proc/ppm/policy/userlimit_min_cpu_freq "1 -1"
    write /proc/ppm/policy/userlimit_min_cpu_core "1 -1"

# Display
# SurfaceFlinger, composer@2.1 and allocator@2.0 come from their AOSP rc files.

# Second-stage boot logo (the LK logo is upside down on this device, see
# vendor.prop).
service bootlogoupdater /vendor/bin/boot_logo_updater
    class core
    oneshot

# MediaTek picture-quality (pq), ambient-light-adaptive (aal) and GED GPU DVFS
# services. Disabled by default; starting PQ early can break the display.
# Enable with:
#   setprop persist.vendor.meizu_m6.pq 1      (0 stops it)
#   setprop persist.vendor.meizu_m6.aal 1
#   setprop persist.vendor.meizu_m6.ged 1
service pq /vendor/bin/pq
    class main
    user system
    group system graphics
    disabled

service aal /vendor/bin/aal
    class main
    user system
    group system graphics
    disabled

service ged_srv /vendor/bin/ged_srv
    class core
    user system
    group system readproc
    disabled

on property:persist.vendor.meizu_m6.pq=1
    start pq

on property:persist.vendor.meizu_m6.pq=0
    stop pq

on property:persist.vendor.meizu_m6.aal=1
    start aal

on property:persist.vendor.meizu_m6.aal=0
    stop aal

on property:sys.boot_completed=1 && property:persist.vendor.meizu_m6.ged=1
    start ged_srv

on property:persist.vendor.meizu_m6.ged=0
    stop ged_srv

# Power / battery

# SPM (sleep power manager) firmware loader. Without it the SoC has no
# deep-idle/suspend firmware.
service spm_script /vendor/bin/spm_loader
    class core
    user root
    group root
    oneshot

# MediaTek fuel-gauge daemon.
service fuelgauged /vendor/bin/fuelgauged
    class main
    user root
    group root

service fuelgauged_nvram /vendor/bin/fuelgauged_nvram
    class main
    user root
    group root
    oneshot
