# mBack daemon: tap=Back, click=Home, hold=Recents from the single mtk-kpd
# capacitive button. Grabs /dev/input/event1 and re-injects through uinput
# ("mbackd-keys", Vendor_4642_Product_0001.kl); volume/power are forwarded
# unchanged. If the daemon dies, the Generic.kl mapping (102 -> HOME) applies.
# The explicit seclabel needs a real domain before an enforcing build.
service mbackd /system/bin/mbackd
    class late_start
    user system
    group system input net_bt_admin
    seclabel u:r:init:s0
